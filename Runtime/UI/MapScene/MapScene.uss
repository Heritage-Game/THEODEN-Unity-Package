.map-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    background-color: rgb(247, 247, 244);
    color: rgb(28, 39, 29);
    overflow: hidden;
}

.safe-area {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.top-bar {
    height: 150px;
    min-height: 150px;
    padding-left: 34px;
    padding-right: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.top-bar-button {
    width: 112px;
    height: 112px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.top-bar-button:hover,
.top-bar-button:active {
    background-color: rgba(132, 196, 65, 0.12);
}

.ui-icon {
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(40, 48, 41);
}

.top-bar-button .ui-icon {
    width: 64px;
    height: 64px;
}

.icon--back { background-image: url("Icons/back.png"); }
.icon--menu { background-image: url("Icons/menu.png"); }
.icon--zoom-in { background-image: url("Icons/plus.png"); }
.icon--zoom-out { background-image: url("Icons/minus.png"); }
.icon--recenter { background-image: url("Icons/recenter.png"); }
.icon--discover { background-image: url("Icons/discover.png"); }
.icon--map { background-image: url("Icons/map.png"); }
.icon--codex { background-image: url("Icons/codex.png"); }
.icon--score { background-image: url("Icons/score.png"); }
.icon--landmark { background-image: url("Icons/landmark.png"); }

.institution-logo {
    width: 104px;
    height: 104px;
    border-width: 4px;
    border-color: rgb(47, 73, 49);
    border-radius: 52px;
    background-color: rgb(255, 255, 252);
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.institution-logo-fallback {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(47, 73, 49);
    -unity-text-align: middle-center;
}

.map-heading {
    padding-left: 54px;
    padding-right: 54px;
    padding-top: 10px;
    padding-bottom: 28px;
    flex-shrink: 0;
}

.map-title {
    font-size: 68px;
    -unity-font-style: bold;
    color: rgb(28, 51, 31);
    margin-bottom: 10px;
}

.map-progress {
    font-size: 36px;
    color: rgb(105, 101, 91);
}

.map-region {
    position: relative;
    flex-grow: 1;
    min-height: 0;
}

.map-viewport {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 0;
    bottom: 180px;
    overflow: hidden;
    background-color: rgb(229, 226, 202);
    border-radius: 58px;
}

.map-content {
    position: absolute;
    transform-origin: center;
}

.map-image,
.map-placeholder,
.pins-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.map-image {
    background-color: rgb(228, 226, 199);
    -unity-background-scale-mode: stretch-to-fill;
}

.map-placeholder {
    overflow: hidden;
    background-color: rgb(226, 224, 194);
}

.map-placeholder-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 46%;
    font-size: 40px;
    color: rgba(50, 71, 47, 0.58);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pins-layer {
    overflow: visible;
}

.map-pin {
    position: absolute;
    width: 106px;
    height: 106px;
    translate: -50% -50%;
    padding: 0;
    border-width: 8px;
    border-color: rgb(255, 255, 255);
    border-radius: 53px;
    align-items: center;
    justify-content: center;
}

.map-pin:hover {
    border-width: 11px;
}

.map-pin--completed {
    background-color: rgb(55, 135, 62);
}

.map-pin--directions {
    background-color: rgb(112, 177, 57);
}

.map-pin--locked {
    background-color: rgb(152, 153, 148);
}

.map-pin--selected {
    width: 126px;
    height: 126px;
    border-radius: 63px;
    border-color: rgb(255, 247, 207);
    border-width: 12px;
}

.map-pin-icon {
    width: 52px;
    height: 52px;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.map-pin-icon--completed {
    background-image: url("Icons/check.png");
}

.map-pin-icon--directions {
    background-image: url("Icons/compass.png");
}

.map-pin-icon--locked {
    background-image: url("Icons/lock.png");
}

.map-status-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(247, 247, 244, 0.86);
    align-items: center;
    justify-content: center;
}

.map-status-label {
    max-width: 76%;
    font-size: 34px;
    color: rgb(47, 73, 49);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.map-status-overlay--error .map-status-label {
    color: rgb(157, 53, 47);
}

.zoom-controls {
    position: absolute;
    right: 56px;
    top: 32%;
    width: 112px;
    height: 226px;
    background-color: rgb(255, 255, 252);
    border-radius: 56px;
    border-width: 2px;
    border-color: rgba(39, 52, 39, 0.10);
    align-items: stretch;
}

.zoom-button {
    flex-grow: 1;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.zoom-button:hover,
.zoom-button:active {
    background-color: rgba(132, 196, 65, 0.12);
}

.zoom-icon {
    width: 52px;
    height: 52px;
}

.zoom-button--top {
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
}

.zoom-button--bottom {
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}

.zoom-divider {
    height: 2px;
    margin-left: 20px;
    margin-right: 20px;
    background-color: rgb(224, 223, 216);
}

.recenter-button {
    position: absolute;
    right: 56px;
    top: 50%;
    width: 112px;
    height: 112px;
    padding: 0;
    background-color: rgb(255, 255, 252);
    border-width: 2px;
    border-color: rgba(39, 52, 39, 0.10);
    border-radius: 56px;
    align-items: center;
    justify-content: center;
}

.recenter-icon {
    width: 58px;
    height: 58px;
    -unity-background-image-tint-color: rgb(65, 139, 60);
}

.poi-card-shadow {
    position: absolute;
    left: 36px;
    right: 20px;
    bottom: 18px;
    height: 304px;
    background-color: rgba(32, 43, 34, 0.12);
    border-radius: 58px;
}

.poi-card {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 30px;
    height: 304px;
    padding: 30px 34px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgb(255, 255, 252);
    border-radius: 54px;
}

.poi-thumbnail {
    width: 238px;
    min-width: 238px;
    height: 238px;
    margin-right: 34px;
    background-color: rgb(230, 225, 200);
    border-radius: 36px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.poi-thumbnail-icon {
    width: 112px;
    height: 112px;
    -unity-background-image-tint-color: rgb(82, 112, 74);
}

.poi-thumbnail--completed {
    background-color: rgb(218, 235, 199);
}

.poi-card-content {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.poi-title {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(22, 31, 23);
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
}

.poi-distance {
    display: none;
}

.poi-card-actions {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.poi-status {
    height: 76px;
    padding-left: 24px;
    padding-right: 24px;
    border-width: 3px;
    border-color: rgba(112, 177, 57, 0.58);
    border-radius: 26px;
    color: rgb(47, 73, 49);
    font-size: 30px;
    -unity-text-align: middle-center;
}

.directions-button {
    height: 88px;
    min-width: 300px;
    padding-left: 28px;
    padding-right: 28px;
    background-color: rgb(112, 177, 57);
    border-width: 0;
    border-radius: 34px;
    color: rgb(255, 255, 255);
    font-size: 33px;
    -unity-font-style: bold;
}

.directions-button:hover {
    background-color: rgb(99, 161, 48);
}

.directions-button:active {
    background-color: rgb(82, 141, 38);
}

.bottom-navigation {
    height: 186px;
    min-height: 186px;
    padding-left: 20px;
    padding-right: 20px;
    flex-direction: row;
    align-items: stretch;
    flex-shrink: 0;
    background-color: rgb(255, 255, 252);
    border-top-width: 2px;
    border-top-color: rgb(229, 229, 222);
}

.nav-button {
    position: relative;
    flex-grow: 1;
    height: 100%;
    padding: 18px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.nav-button:hover,
.nav-button:active {
    background-color: rgba(132, 196, 65, 0.08);
}

.nav-icon {
    width: 68px;
    height: 68px;
    margin-bottom: 5px;
    -unity-background-image-tint-color: rgb(60, 61, 57);
}

.nav-label {
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(60, 61, 57);
    -unity-text-align: middle-center;
}

.nav-button--active .nav-icon {
    -unity-background-image-tint-color: rgb(112, 177, 57);
}

.nav-button--active .nav-label {
    color: rgb(96, 166, 45);
}

.nav-active-indicator {
    position: absolute;
    left: 34%;
    right: 34%;
    bottom: 8px;
    height: 8px;
    background-color: rgb(112, 177, 57);
    border-radius: 4px;
}

/* Applied by MapSceneController for landscape or small runtime panels. */
.map-screen--compact .top-bar {
    height: 92px;
    min-height: 92px;
}

.map-screen--compact .top-bar-button {
    width: 72px;
    height: 72px;
}

.map-screen--compact .top-bar-button .ui-icon {
    width: 42px;
    height: 42px;
}

.map-screen--compact .institution-logo {
    width: 68px;
    height: 68px;
    border-radius: 34px;
}

.map-screen--compact .institution-logo-fallback {
    font-size: 22px;
}

.map-screen--compact .map-heading {
    padding: 4px 32px 12px 32px;
}

.map-screen--compact .map-title {
    font-size: 42px;
    margin-bottom: 2px;
}

.map-screen--compact .map-progress {
    font-size: 24px;
}

.map-screen--compact .bottom-navigation {
    height: 112px;
    min-height: 112px;
}

.map-screen--compact .nav-button {
    padding: 8px 0;
}

.map-screen--compact .nav-icon {
    width: 42px;
    height: 42px;
}

.map-screen--compact .nav-label {
    font-size: 20px;
}

.map-screen--compact .map-viewport {
    bottom: 104px;
}

.map-screen--compact .poi-card,
.map-screen--compact .poi-card-shadow {
    height: 174px;
    border-radius: 34px;
}

.map-screen--compact .poi-card {
    padding: 18px 22px;
}

.map-screen--compact .poi-thumbnail {
    width: 138px;
    min-width: 138px;
    height: 138px;
    margin-right: 20px;
    border-radius: 24px;
}

.map-screen--compact .poi-thumbnail-icon {
    width: 68px;
    height: 68px;
}

.map-screen--compact .poi-title {
    font-size: 32px;
}

.map-screen--compact .poi-status {
    height: 48px;
    font-size: 20px;
}

.map-screen--compact .directions-button {
    height: 56px;
    min-width: 210px;
    font-size: 22px;
}

.map-screen--compact .zoom-controls {
    right: 38px;
    width: 76px;
    height: 152px;
    border-radius: 38px;
}

.map-screen--compact .recenter-button {
    right: 38px;
    width: 76px;
    height: 76px;
    border-radius: 38px;
}

.map-screen--compact .map-pin {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    border-width: 5px;
}

.map-screen--compact .map-pin--selected {
    width: 86px;
    height: 86px;
    border-radius: 43px;
    border-width: 7px;
}

.map-screen--compact .map-pin-icon {
    width: 36px;
    height: 36px;
}
